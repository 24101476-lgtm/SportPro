rules_version = '2';

// Reglas de seguridad de SportPro.
// Copiar en Firebase Console > Firestore Database > Reglas y pulsar "Publicar".
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function rol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && rol() == 'ADMINISTRADOR';
    }

    // Administrador o entrenador: personal que gestiona el plantel.
    function esStaff() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && rol() in ['ADMINISTRADOR', 'ENTRENADOR'];
    }

    // Academia del usuario autenticado. Mientras no esté vinculado a un club (clubId nulo)
    // se usa 'academia-demo', igual que la app (PerfilActual.ACADEMIA_POR_DEFECTO).
    function academiaPropia() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('clubId', null) == null
        ? 'academia-demo'
        : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.clubId;
    }

    // Código de invitación existente, sin usar y sin revocar (registro de Administrador).
    function codigoInvitacionValido(codigo) {
      return codigo is string
        && codigo.size() == 8
        && exists(/databases/$(database)/documents/codigosInvitacion/$(codigo))
        && get(/databases/$(database)/documents/codigosInvitacion/$(codigo)).data.get('usado', false) == false
        && get(/databases/$(database)/documents/codigosInvitacion/$(codigo)).data.get('revocado', false) == false;
    }

    // Perfil de cada usuario.
    // - Cada uno crea solo su propio perfil, ACTIVO y sin academia. Nadie se asigna el rol de
    //   ADMINISTRADOR sin un código de invitación válido (antes bastaba con escribirlo).
    // - El usuario edita sus datos, pero no su rol, estado, academia ni la marca de menor de edad;
    //   eso solo lo cambia un administrador.
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.estado == 'ACTIVO'
        && request.resource.data.get('clubId', null) == null
        && (request.resource.data.rol in ['ENTRENADOR', 'JUGADOR', 'PADRE_DE_FAMILIA']
          || (request.resource.data.rol == 'ADMINISTRADOR'
            && codigoInvitacionValido(request.resource.data.get('codigoInvitacion', ''))));
      allow update: if autenticado() && (
        esAdmin()
        || (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'rol', 'estado', 'clubId', 'esMenor']))
      );
      allow delete: if false;
    }

    // Catálogo configurable de eventos: todos lo leen; la configuración es del administrador.
    // Se permite crear el catálogo base la primera vez desde la app.
    match /catalogoEventos/{tipoId} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update, delete: if esAdmin();
    }

    // US-001/US-004: códigos de invitación de 8 caracteres para crear cuentas de Administrador.
    // El ID del documento es el propio código.
    match /codigosInvitacion/{codigo} {
      // Durante el registro la app solo hace `get` del código: la cuenta de Firebase Auth ya
      // existe (el usuario queda autenticado) pero todavía no tiene documento en `usuarios`.
      allow get: if autenticado();
      // Recorrer el listado de códigos es una operación del administrador de una academia.
      allow list: if esAdmin();

      allow create: if esAdmin();

      // Marcar el código como usado: lo hace el propio usuario que se registra, y solo puede
      // escribir esos tres campos sobre un código que todavía no fue usado.
      allow update: if esAdmin()
        || (autenticado()
            && resource.data.get('usadoPorUid', null) == null
            && request.resource.data.usado == true
            && request.resource.data.usadoPorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'usado', 'usadoPorUid', 'usadoEn'
               ]));

      allow delete: if esAdmin();
    }

    // US-004/US-005: equipos por categoría. Los lee cualquier usuario autenticado; solo el
    // administrador de la misma academia los crea o edita. No se borran: se desactivan.
    match /equipos/{equipoId} {
      allow read: if autenticado();
      allow create: if esAdmin()
        && request.resource.data.academiaId == academiaPropia()
        && request.resource.data.creadoPor == request.auth.uid;
      allow update: if esAdmin()
        && resource.data.academiaId == academiaPropia()
        && request.resource.data.academiaId == resource.data.academiaId;
      allow delete: if false;
    }

    // US-007: el padre tiene un vínculo aprobado con el jugador. El id del vínculo es
    // {padreUid}_{jugadorId}, así basta un `get` para comprobarlo.
    function vinculoAprobado(jugadorId) {
      return autenticado()
        && exists(/databases/$(database)/documents/vinculaciones/$(request.auth.uid + '_' + jugadorId))
        && get(/databases/$(database)/documents/vinculaciones/$(request.auth.uid + '_' + jugadorId)).data.estado == 'APROBADA';
    }

    // US-006/US-007: perfil del jugador. Incluye datos físicos y de contacto de posibles menores
    // de edad, por eso solo lo leen el administrador y el entrenador de su academia, y el
    // apoderado con vínculo aprobado (solo el de su hijo). Solo el personal lo edita.
    match /jugadores/{jugadorId} {
      allow read: if (esStaff() && resource.data.academiaId == academiaPropia())
        || vinculoAprobado(jugadorId);
      allow create: if esStaff()
        && request.resource.data.academiaId == academiaPropia()
        && request.resource.data.creadoPor == request.auth.uid;
      allow update: if esStaff()
        && resource.data.academiaId == academiaPropia()
        && request.resource.data.academiaId == resource.data.academiaId;
      allow delete: if false;
    }

    // US-009 a US-013: entrenamientos y su asistencia (solo ids y estados, sin datos
    // personales). Los lee cualquier usuario autenticado; los gestiona el personal.
    match /entrenamientos/{entrenamientoId} {
      allow read: if autenticado();
      allow create: if esStaff()
        && request.resource.data.academiaId == academiaPropia()
        && request.resource.data.creadoPor == request.auth.uid;
      // US-011: una sesión Realizada ya no acepta cambios de asistencia (incluidas marcas
      // hechas sin conexión que lleguen después del cierre).
      allow update: if esStaff()
        && resource.data.academiaId == academiaPropia()
        && request.resource.data.academiaId == resource.data.academiaId
        && !(resource.data.get('estado', '') == 'REALIZADA'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['asistencia', 'asistenciaDetalle', 'estado']));
      allow delete: if false;

      // US-011: cada cambio de asistencia queda registrado; nunca se edita ni se borra.
      match /historial_asistencia/{registroId} {
        allow read: if esStaff();
        allow create: if esStaff() && request.resource.data.marcadoPor == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // US-009: biblioteca reutilizable de ejercicios. La ven todos los entrenadores y el
    // administrador de la misma academia; solo el autor o el administrador la editan,
    // desactivan o eliminan. El autor y la academia no pueden cambiarse al editar.
    // (La app solo elimina ejercicios que nunca se usaron en una sesión realizada.)
    function esAutorOAdmin(datos) {
      return esAdmin() || datos.get('creadoPor', '') == request.auth.uid;
    }

    match /ejercicios/{ejercicioId} {
      allow read: if esStaff() && resource.data.academiaId == academiaPropia();
      allow create: if esStaff()
        && request.resource.data.academiaId == academiaPropia()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.activo == true
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 60
        && request.resource.data.duracionMin is int
        && request.resource.data.duracionMin >= 1 && request.resource.data.duracionMin <= 120;
      allow update: if esStaff()
        && resource.data.academiaId == academiaPropia()
        && esAutorOAdmin(resource.data)
        && request.resource.data.academiaId == resource.data.academiaId
        && request.resource.data.get('creadoPor', '') == resource.data.get('creadoPor', '')
        && (request.resource.data.duracionMin == resource.data.duracionMin
          || (request.resource.data.duracionMin is int
            && request.resource.data.duracionMin >= 1 && request.resource.data.duracionMin <= 120));
      allow delete: if esStaff()
        && resource.data.academiaId == academiaPropia()
        && esAutorOAdmin(resource.data);
    }

    // Registro por jugador y entrenamiento que consume el módulo de Estadísticas.
    match /asistencias_entrenamiento/{asistenciaId} {
      allow read: if autenticado();
      allow create, update: if esStaff();
      allow delete: if false;
    }

    // ------------------------------------------------------------------------------------
    // Colecciones de los módulos Mensualidades, Estadísticas/Anuncios y Comunidad.
    // TEMPORAL: sin una regla explícita Firestore las rechaza y esas pantallas fallan. Estas
    // reglas permiten el uso a usuarios autenticados; cada responsable de módulo debe
    // endurecerlas (por rol y por academia) antes de manejar datos reales.
    // ------------------------------------------------------------------------------------

    // US-008 (simulado, sin cobros reales): todos leen su información; solo el administrador
    // registra o anula pagos.
    match /mensualidades/{id} {
      allow read: if autenticado();
      allow create, update: if esAdmin();
      allow delete: if false;
    }

    // US-007: datos mínimos de cada jugador (nombre, equipo, código y contador de apoderados)
    // para que el padre de la misma academia pida la vinculación. Sin datos sensibles.
    match /directorio_jugadores/{jugadorId} {
      allow read: if autenticado() && resource.data.academiaId == academiaPropia();
      allow create, update: if esStaff()
        && request.resource.data.academiaId == academiaPropia()
        && request.resource.data.get('apoderadosAprobados', 0) >= 0
        && request.resource.data.get('apoderadosAprobados', 0) <= 2;
      allow delete: if false;
    }

    // US-007: vínculo padre/madre ↔ jugador, con id {padreUid}_{jugadorId}.
    // - El padre lee los suyos y crea (o reenvía tras un rechazo o revocación) su solicitud
    //   PENDIENTE, siempre a su nombre.
    // - El personal de la academia aprueba o rechaza las pendientes; solo el administrador
    //   revoca una aprobada. Padre y jugador del vínculo no se pueden cambiar.
    match /vinculaciones/{vinculacionId} {
      function solicitudPropiaValida() {
        return rol() == 'PADRE_DE_FAMILIA'
          && vinculacionId == request.auth.uid + '_' + request.resource.data.jugadorId
          && request.resource.data.padreUid == request.auth.uid
          && request.resource.data.estado == 'PENDIENTE'
          && request.resource.data.academiaId == academiaPropia();
      }

      allow read: if autenticado()
        && (resource.data.padreUid == request.auth.uid
          || (esStaff() && resource.data.academiaId == academiaPropia()));

      allow create: if autenticado() && solicitudPropiaValida();

      allow update: if autenticado() && (
        (solicitudPropiaValida() && resource.data.estado in ['RECHAZADA', 'REVOCADA'])
        || (esStaff()
          && resource.data.academiaId == academiaPropia()
          && request.resource.data.academiaId == resource.data.academiaId
          && request.resource.data.padreUid == resource.data.padreUid
          && request.resource.data.jugadorId == resource.data.jugadorId
          && ((resource.data.estado == 'PENDIENTE' && request.resource.data.estado in ['APROBADA', 'RECHAZADA'])
            || (esAdmin() && resource.data.estado == 'APROBADA' && request.resource.data.estado == 'REVOCADA')))
      );

      allow delete: if false;

      // Criterio 8: registro de cada acción; nunca se edita ni se borra.
      match /auditoria/{registroId} {
        allow read: if esStaff();
        allow create: if autenticado() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // US-026/US-027: anuncios y preferencias de notificación.
    // Publican, editan y archivan el entrenador y el administrador; cualquier usuario puede
    // marcar un anuncio como leído (agregarse a sí mismo a `lecturas`).
    match /anuncios/{id} {
      allow read: if autenticado();
      allow create: if esStaff() && request.resource.data.autorUid == request.auth.uid;
      allow update: if esStaff()
        || (autenticado()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lecturas'])
          && request.resource.data.lecturas.toSet().difference(resource.data.get('lecturas', []).toSet())
            .hasOnly([request.auth.uid]));
      allow delete: if false;
    }
    // Preferencias de cada usuario: solo las suyas.
    match /preferencias_notificaciones/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    // US-028/US-029/US-030: comunidad, avisos y moderación.
    match /publicaciones/{id} {
      allow read: if autenticado();
      allow write: if autenticado();

      match /comentarios/{comentarioId} {
        allow read: if autenticado();
        allow write: if autenticado();
      }
    }
    match /avisos/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }
    // Reportes: cualquiera reporta a su nombre y ve sus propios reportes (para no duplicarlos);
    // solo el administrador ve la bandeja y los resuelve.
    match /reportes/{id} {
      allow create: if autenticado() && request.resource.data.reportadoPorUid == request.auth.uid;
      allow read: if esAdmin() || (autenticado() && resource.data.reportadoPorUid == request.auth.uid);
      allow update: if esAdmin();
      allow delete: if false;
    }
    // Bloqueos: id {uidBloqueador}_{uidBloqueado}. Cada uno gestiona los suyos y puede saber quién
    // lo bloqueó (para ocultar ese contenido en su muro).
    match /bloqueos/{id} {
      allow read: if autenticado()
        && (resource.data.uidBloqueador == request.auth.uid || resource.data.uidBloqueado == request.auth.uid);
      allow create: if autenticado()
        && request.resource.data.uidBloqueador == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.uidBloqueado;
      allow delete: if autenticado() && resource.data.uidBloqueador == request.auth.uid;
      allow update: if false;
    }
    // Suspensiones: las aplica el administrador; cada usuario puede leer la suya.
    match /suspensiones/{uid} {
      allow read: if autenticado();
      allow write: if esAdmin();
    }

    match /partidos/{partidoId} {
      // getAfter: permite validar escrituras hechas en el mismo lote que crea o actualiza el partido.
      function partido() {
        return getAfter(/databases/$(database)/documents/partidos/$(partidoId)).data;
      }

      // Operador asignado, entrenador responsable, creador del partido o administrador.
      function puedeOperarCon(datos) {
        return autenticado() && (
          esAdmin()
          || request.auth.uid == datos.get('operadorUid', '')
          || request.auth.uid == datos.get('entrenadorUid', '')
          || request.auth.uid == datos.get('creadoPor', '')
        );
      }

      function puedeOperar() {
        return puedeOperarCon(partido());
      }

      // Acta cerrada: el estado queda en FINALIZADO (lo consulta Estadísticas) y se marca
      // actaCerrada = true. Se mantiene 'ACTA_CERRADA' por compatibilidad con partidos antiguos.
      function actaCerrada(datos) {
        return datos.get('actaCerrada', false) == true || datos.get('estado', '') == 'ACTA_CERRADA';
      }

      allow read: if autenticado();
      // Solo el personal (administrador o entrenador) programa partidos.
      allow create: if esStaff() && request.resource.data.creadoPor == request.auth.uid;
      allow update: if puedeOperarCon(resource.data) && !actaCerrada(resource.data);
      allow delete: if esAdmin();

      match /convocados/{jugadorId} {
        allow read: if autenticado();
        allow write: if puedeOperar();
      }

      // Eventos del partido: nunca se eliminan físicamente.
      match /eventos/{eventoId} {
        allow read: if autenticado();

        allow create: if puedeOperar()
          && !actaCerrada(get(/databases/$(database)/documents/partidos/$(partidoId)).data)
          && request.resource.data.operadorUid == request.auth.uid
          && request.resource.data.estado == 'VIGENTE'
          && request.resource.data.minuto is int
          && request.resource.data.minuto >= 0
          && request.resource.data.minuto <= 130;

        // Solo se permite cambiar el estado (Reemplazado / Anulado) y sus datos de trazabilidad;
        // el contenido original del evento no se puede sobrescribir.
        allow update: if puedeOperar()
          && !actaCerrada(get(/databases/$(database)/documents/partidos/$(partidoId)).data)
          && resource.data.estado == 'VIGENTE'
          && request.resource.data.estado in ['REEMPLAZADO', 'ANULADO']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'estado', 'reemplazadoPor', 'reemplazadoPorUid', 'reemplazadoEn',
               'motivoAnulacion', 'anuladoPor', 'anuladoPorNombre', 'anuladoEn'
             ]);

        allow delete: if false;
      }
    }
  }
}
