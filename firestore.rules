rules_version = '2';

// Reglas de seguridad de SportPro.
// Copiar en Firebase Console > Firestore Database > Reglas y pulsar "Publicar".
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function rol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && rol() == 'ADMINISTRADOR';
    }

    // Administrador o entrenador: personal que gestiona el plantel.
    function esStaff() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && rol() in ['ADMINISTRADOR', 'ENTRENADOR'];
    }

    // Academia del usuario autenticado. Mientras no esté vinculado a un club (clubId nulo)
    // se usa 'academia-demo', igual que la app (PerfilActual.ACADEMIA_POR_DEFECTO).
    function academiaPropia() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('clubId', null) == null
        ? 'academia-demo'
        : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.clubId;
    }

    // Perfil de cada usuario.
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow write: if autenticado() && request.auth.uid == uid;
    }

    // Catálogo configurable de eventos: todos lo leen; la configuración es del administrador.
    // Se permite crear el catálogo base la primera vez desde la app.
    match /catalogoEventos/{tipoId} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update, delete: if esAdmin();
    }

    // US-001/US-004: códigos de invitación de 8 caracteres para crear cuentas de Administrador.
    // El ID del documento es el propio código.
    match /codigosInvitacion/{codigo} {
      // Durante el registro la app solo hace `get` del código: la cuenta de Firebase Auth ya
      // existe (el usuario queda autenticado) pero todavía no tiene documento en `usuarios`.
      allow get: if autenticado();
      // Recorrer el listado de códigos es una operación del administrador de una academia.
      allow list: if esAdmin();

      allow create: if esAdmin();

      // Marcar el código como usado: lo hace el propio usuario que se registra, y solo puede
      // escribir esos tres campos sobre un código que todavía no fue usado.
      allow update: if esAdmin()
        || (autenticado()
            && resource.data.get('usadoPorUid', null) == null
            && request.resource.data.usado == true
            && request.resource.data.usadoPorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'usado', 'usadoPorUid', 'usadoEn'
               ]));

      allow delete: if esAdmin();
    }

    // US-004/US-005: equipos por categoría. Los lee cualquier usuario autenticado; solo el
    // administrador de la misma academia los crea o edita. No se borran: se desactivan.
    match /equipos/{equipoId} {
      allow read: if autenticado();
      allow create: if esAdmin()
        && request.resource.data.academiaId == academiaPropia()
        && request.resource.data.creadoPor == request.auth.uid;
      allow update: if esAdmin()
        && resource.data.academiaId == academiaPropia()
        && request.resource.data.academiaId == resource.data.academiaId;
      allow delete: if false;
    }

    // US-006/US-007: perfil del jugador. Incluye datos físicos y de contacto de posibles menores
    // de edad, por eso solo lo leen y editan el administrador y el entrenador de su academia.
    match /jugadores/{jugadorId} {
      allow read: if esStaff() && resource.data.academiaId == academiaPropia();
      allow create: if esStaff()
        && request.resource.data.academiaId == academiaPropia()
        && request.resource.data.creadoPor == request.auth.uid;
      allow update: if esStaff()
        && resource.data.academiaId == academiaPropia()
        && request.resource.data.academiaId == resource.data.academiaId;
      allow delete: if false;
    }

    // US-009 a US-013: entrenamientos y su asistencia (solo ids y estados, sin datos
    // personales). Los lee cualquier usuario autenticado; los gestiona el personal.
    match /entrenamientos/{entrenamientoId} {
      allow read: if autenticado();
      allow create: if esStaff()
        && request.resource.data.academiaId == academiaPropia()
        && request.resource.data.creadoPor == request.auth.uid;
      allow update: if esStaff()
        && resource.data.academiaId == academiaPropia()
        && request.resource.data.academiaId == resource.data.academiaId;
      allow delete: if false;
    }

    // Biblioteca reutilizable de ejercicios de la academia.
    match /ejercicios/{ejercicioId} {
      allow read: if esStaff();
      allow create: if esStaff() && request.resource.data.academiaId == academiaPropia();
      allow update, delete: if false;
    }

    // Registro por jugador y entrenamiento que consume el módulo de Estadísticas.
    match /asistencias_entrenamiento/{asistenciaId} {
      allow read: if autenticado();
      allow create, update: if esStaff();
      allow delete: if false;
    }

    // ------------------------------------------------------------------------------------
    // Colecciones de los módulos Mensualidades, Estadísticas/Anuncios y Comunidad.
    // TEMPORAL: sin una regla explícita Firestore las rechaza y esas pantallas fallan. Estas
    // reglas permiten el uso a usuarios autenticados; cada responsable de módulo debe
    // endurecerlas (por rol y por academia) antes de manejar datos reales.
    // ------------------------------------------------------------------------------------

    // US-008 (simulado, sin cobros reales): todos leen su información; solo el administrador
    // registra o anula pagos.
    match /mensualidades/{id} {
      allow read: if autenticado();
      allow create, update: if esAdmin();
      allow delete: if false;
    }

    // Vínculo padre/madre ↔ jugador.
    match /vinculaciones/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }

    // US-026/US-027: anuncios y preferencias de notificación.
    match /anuncios/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }
    match /preferencias_notificaciones/{id} {
      allow read, write: if autenticado();
    }

    // US-028/US-029/US-030: comunidad, avisos y moderación.
    match /publicaciones/{id} {
      allow read: if autenticado();
      allow write: if autenticado();

      match /comentarios/{comentarioId} {
        allow read: if autenticado();
        allow write: if autenticado();
      }
    }
    match /avisos/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }
    match /reportes/{id} {
      allow read, write: if autenticado();
    }
    match /bloqueos/{id} {
      allow read, write: if autenticado();
    }
    match /suspensiones/{id} {
      allow read, write: if autenticado();
    }

    match /partidos/{partidoId} {
      // getAfter: permite validar escrituras hechas en el mismo lote que crea o actualiza el partido.
      function partido() {
        return getAfter(/databases/$(database)/documents/partidos/$(partidoId)).data;
      }

      // Operador asignado, entrenador responsable, creador del partido o administrador.
      function puedeOperarCon(datos) {
        return autenticado() && (
          esAdmin()
          || request.auth.uid == datos.get('operadorUid', '')
          || request.auth.uid == datos.get('entrenadorUid', '')
          || request.auth.uid == datos.get('creadoPor', '')
        );
      }

      function puedeOperar() {
        return puedeOperarCon(partido());
      }

      allow read: if autenticado();
      allow create: if autenticado() && request.resource.data.creadoPor == request.auth.uid;
      allow update: if puedeOperarCon(resource.data) && resource.data.estado != 'ACTA_CERRADA';
      allow delete: if esAdmin();

      match /convocados/{jugadorId} {
        allow read: if autenticado();
        allow write: if puedeOperar();
      }

      // Eventos del partido: nunca se eliminan físicamente.
      match /eventos/{eventoId} {
        allow read: if autenticado();

        allow create: if puedeOperar()
          && get(/databases/$(database)/documents/partidos/$(partidoId)).data.estado != 'ACTA_CERRADA'
          && request.resource.data.operadorUid == request.auth.uid
          && request.resource.data.estado == 'VIGENTE'
          && request.resource.data.minuto is int
          && request.resource.data.minuto >= 0
          && request.resource.data.minuto <= 130;

        // Solo se permite cambiar el estado (Reemplazado / Anulado) y sus datos de trazabilidad;
        // el contenido original del evento no se puede sobrescribir.
        allow update: if puedeOperar()
          && partido().estado != 'ACTA_CERRADA'
          && resource.data.estado == 'VIGENTE'
          && request.resource.data.estado in ['REEMPLAZADO', 'ANULADO']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'estado', 'reemplazadoPor', 'reemplazadoPorUid', 'reemplazadoEn',
               'motivoAnulacion', 'anuladoPor', 'anuladoPorNombre', 'anuladoEn'
             ]);

        allow delete: if false;
      }
    }
  }
}
