 create mode 100644 app/src/main/java/com/esan/sportpro/domain/mensualidades/TipoPago.kt

diff --git a/app/src/main/java/com/esan/sportpro/domain/mensualidades/TipoPago.kt b/app/src/main/java/com/esan/sportpro/domain/mensualidades/TipoPago.kt
