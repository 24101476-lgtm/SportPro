                 val pagoPorJugador = pagos.associateBy { it.jugadorId }
+                val equipos = jugadores.filter { it.activo && it.equipoId.isNotBlank() }
+                    .map { EquipoOpcion(it.equipoId, it.equipoNombre.ifBlank { "Equipo" }) }
+                    .distinctBy { it.id }
+                    .sortedBy { it.nombre.lowercase() }
