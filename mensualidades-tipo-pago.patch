@@ -0,0 +1,19 @@
+package com.esan.sportpro.domain.mensualidades
+
+/**
+ * Tipo de mensualidad que el administrador elige al registrar un pago (US-008), en vez de
+ * escribir el monto a mano. Los montos son referenciales y simulados: se cambian aquí, en un
+ * solo lugar. [OTRO] deja escribir un monto distinto (rango 0.00..5000.00).
+ */
+enum class TipoPago(
+    val etiqueta: String,
+    /** Monto fijo del tipo; `null` si el administrador lo escribe ([OTRO]). */
+    val monto: Double?,
+    /** Estado que corresponde por defecto a este tipo (la beca exonera el pago). */
+    val estado: EstadoMensualidad?,
+) {
+    NORMAL("Pago normal", 100.0, null),
+    PROMO("Pago promo", 80.0, null),
+    BECA("Beca", 0.0, EstadoMensualidad.EXONERADO),
+    OTRO("Otro monto", null, null),
+}
diff --git a/app/src/main/java/com/esan/sportpro/ui/mensualidades/MensualidadRegistrarScreen.kt b/app/src/main/java/com/esan/sportpro/ui/mensualidades/MensualidadRegistrarScreen.kt
