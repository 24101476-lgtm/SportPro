@@ -102,6 +104,19 @@ class MensualidadRegistrarViewModel @Inject constructor(
 
     fun onMesAnioChanged(mes: Int, anio: Int) = setState { copy(mes = mes, anio = anio) }
 
+    /** Elige el tipo de pago: fija el monto (o lo deja libre en "Otro") y el estado si corresponde. */
+    fun onTipoPagoChanged(tipo: TipoPago) {
+        setState {
+            copy(
+                tipoPago = tipo,
+                montoTexto = tipo.monto?.let { "%.2f".format(it) } ?: "",
+                montoError = null,
+                estadoSeleccionado = tipo.estado
+                    ?: if (estadoSeleccionado == EstadoMensualidad.EXONERADO) EstadoMensualidad.PAGADO else estadoSeleccionado,
+            )
+        }
+    }
+
     fun onMontoChanged(texto: String) = setState { copy(montoTexto = texto, montoError = null) }
 
     fun onFechaRegistroChanged(fecha: Date) = setState { copy(fechaRegistro = fecha) }
